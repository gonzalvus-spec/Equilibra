{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "terminales": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        },
        "dispositivos": {
          "varayoc_01": {
            "historial": {
              ".indexOn": ["timestamp"]
            }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
